# ---- Required ----
# Postgres. Locally: any Postgres. Production: Neon free tier (use the POOLED url here).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Neon's DIRECT (non-pooled) url, used only for migrations. Locally, same as DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Public site address, no trailing slash. On Netlify this falls back to the site URL automatically.
APP_URL="http://localhost:3000"
# Comma-separated emails that become admins when they sign up.
ADMIN_EMAILS="you@example.com"
# Long random string; protects the hourly housekeeping endpoint. e.g. `openssl rand -hex 32`
CRON_SECRET=""

# ---- Payments (Stripe Connect). Leave empty for demo mode (no real money). ----
STRIPE_SECRET_KEY=""          # sk_test_... first, sk_live_... when you launch
STRIPE_WEBHOOK_SECRET=""      # whsec_... from the Connect webhook endpoint

# ---- Email (Resend). Leave empty to print emails to the server log. ----
RESEND_API_KEY=""
EMAIL_FROM="TutConnect <hello@yourdomain.com>"
SUPPORT_EMAIL="support@yourdomain.com"

# ---- Optional: Claude drafts tutor lesson plans (paid per use). Empty = built-in template. ----
ANTHROPIC_API_KEY=""
