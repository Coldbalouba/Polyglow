# ===== Server (docker compose) =====
# Your domain, without https:// (Caddy gets the HTTPS certificate automatically).
DOMAIN="example.com"
APP_URL="https://example.com"
# Long random strings. Generate each with: openssl rand -hex 32
POSTGRES_PASSWORD=""
CRON_SECRET=""
# Comma-separated emails that become admins when they sign up.
ADMIN_EMAILS="you@example.com"

# ===== Local development only (docker compose sets these itself) =====
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/polyglow"
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/polyglow"

# ===== Payments: Stripe Connect. Empty = demo mode (no real money). =====
STRIPE_SECRET_KEY=""          # sk_test_... first, sk_live_... at launch
STRIPE_WEBHOOK_SECRET=""      # whsec_... from the Connect webhook endpoint

# ===== Email: set ONE of these. Empty = emails are printed to the app log. =====
# Any SMTP provider, e.g. Amazon SES: smtps://SMTP_USER:SMTP_PASS@email-smtp.eu-west-1.amazonaws.com:465
SMTP_URL=""
RESEND_API_KEY=""
EMAIL_FROM="Polyglow <hello@example.com>"
SUPPORT_EMAIL="support@example.com"

# ===== Optional: Claude drafts tutor lesson plans (paid per use). Empty = built-in template. =====
ANTHROPIC_API_KEY=""
