// TutConnect data model.
// SQLite is used for zero-setup local development. To use Postgres, change
// `provider` to "postgresql" and point DATABASE_URL at your database.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Enum-like string fields (SQLite has no native enums). Allowed values are
// defined in src/lib/constants.ts.

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("STUDENT") // STUDENT | TUTOR | ADMIN
  createdAt    DateTime @default(now())

  sessions        Session[]
  tutorProfile    TutorProfile?
  studentBookings Booking[]     @relation("StudentBookings")
  reviewsWritten  Review[]      @relation("ReviewAuthor")
}

model Session {
  id        String   @id // random token stored in an httpOnly cookie
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TutorProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  headline        String   @default("")
  bio             String   @default("")
  country         String   @default("")
  hourlyRateCents Int      @default(2000)
  // DRAFT -> SUBMITTED -> APPROVED | REJECTED. Only APPROVED tutors are listed.
  status          String   @default("DRAFT")
  // Stripe Connect account id once payouts are set up (stubbed in MVP).
  stripeAccountId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  languages   TutorLanguage[]
  application TutorApplication?
  slots       AvailabilitySlot[]
  bookings    Booking[]
}

model TutorLanguage {
  id       String       @id @default(cuid())
  tutorId  String
  language String // e.g. "Spanish"
  level    String // NATIVE | C2 | C1
  tutor    TutorProfile @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@unique([tutorId, language])
}

model TutorApplication {
  id                 String    @id @default(cuid())
  tutorId            String    @unique
  // Step 1: resume
  resumeFileName     String?
  resumePath         String?
  // Step 2: skill check (auto-scored methodology quiz + written sample in the target language)
  skillCheckScore    Int? // percentage 0-100
  skillCheckPassed   Boolean   @default(false)
  writingSample      String?
  // Step 3: AI-assisted lesson plan
  lessonPlanTitle    String?
  lessonPlan         String?
  lessonPlanAiTool   String? // which AI tool produced the first draft
  // Review
  status             String    @default("IN_PROGRESS") // IN_PROGRESS | SUBMITTED | APPROVED | REJECTED
  submittedAt        DateTime?
  reviewedAt         DateTime?
  reviewerNotes      String?
  // Admin checklist for the human part of the vetting
  resumeVerified     Boolean   @default(false)
  liveCheckPassed    Boolean   @default(false)
  lessonPlanApproved Boolean   @default(false)

  tutor TutorProfile @relation(fields: [tutorId], references: [id], onDelete: Cascade)
}

model AvailabilitySlot {
  id          String       @id @default(cuid())
  tutorId     String
  startsAt    DateTime
  durationMin Int          @default(60)
  isBooked    Boolean      @default(false)
  tutor       TutorProfile @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  bookings    Booking[]

  @@index([tutorId, startsAt])
}

model Booking {
  id               String    @id @default(cuid())
  studentId        String
  tutorId          String
  slotId           String
  language         String
  startsAt         DateTime
  durationMin      Int
  // Money, all in cents. The student pays priceCents; the platform fee is
  // taken out of the tutor's share, never added on top for the student.
  priceCents       Int
  feeRateBps       Int // basis points: 100 = 1%, 500 = 5%
  platformFeeCents Int
  tutorPayoutCents Int
  // PENDING_PAYMENT -> CONFIRMED -> COMPLETED, or CANCELLED
  status           String    @default("PENDING_PAYMENT")
  paymentRef       String?
  createdAt        DateTime  @default(now())
  completedAt      DateTime?

  student User             @relation("StudentBookings", fields: [studentId], references: [id])
  tutor   TutorProfile     @relation(fields: [tutorId], references: [id])
  slot    AvailabilitySlot @relation(fields: [slotId], references: [id])
  review  Review?

  @@index([tutorId, status])
  @@index([studentId])
}

model Review {
  id        String   @id @default(cuid())
  bookingId String   @unique
  authorId  String
  rating    Int // 1-5
  comment   String   @default("")
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  author  User    @relation("ReviewAuthor", fields: [authorId], references: [id])
}
